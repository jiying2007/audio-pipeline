  "datasets": [
    {
      "id": "realman",
      "source": "https://huggingface.co/datasets/AISHELL/RealMAN",
      "license": "CC-BY-4.0",
      "usage_class": "commercial-validation",
      "attribution": "RealMAN: AudioLab at Westlake University and AISHELL Technology; NeurIPS 2024.",
      "local_path": "RealMAN",
      "transforms_allowed": true,
      "validation_roles": ["real-farfield", "multichannel", "moving-source", "static-source", "distance", "speech-enhancement"],
      "recommended_materialization": ["val", "test", "dataset_info", "transcriptions.trn"],
      "notes": "Prefer val/test; do not require the 531 GB training archive for validation."
    },
    {
      "id": "voices",
      "source": "https://iqtlabs.github.io/voices/",
      "license": "CC-BY-4.0",
      "usage_class": "commercial-validation",
      "attribution": "VOiCES corpus by SRI International and Lab41/IQTLabs.",
      "local_path": "VOiCES",
      "transforms_allowed": true,
      "validation_roles": ["real-farfield", "reverberation", "distractor-noise", "obstruction", "microphone-position"],
      "recommended_materialization": ["distant-16k", "source-16k"],
      "notes": "Commercial, academic and government use permitted under CC BY 4.0."
    },
    {
      "id": "but-reverbdb",
      "source": "https://speech.fit.vut.cz/software/but-speech-fit-reverb-database",
      "license": "CC-BY-4.0",
      "usage_class": "commercial-validation",
      "attribution": "BUT Speech@FIT Reverb Database, Brno University of Technology.",
      "local_path": "BUT_ReverbDB",
      "transforms_allowed": true,
      "validation_roles": ["measured-rir", "room-noise", "microphone-position", "reverberation"],
      "recommended_materialization": ["RIR-only"],
      "notes": "RIR-only release is sufficient for measured-room derived validation."
    },
    {
      "id": "musan",
      "source": "https://www.openslr.org/resources/17/musan.tar.gz",
      "license": "CC-BY-4.0",
      "usage_class": "commercial-validation",
      "attribution": "MUSAN corpus by David Snyder, Guoguo Chen and Daniel Povey.",
      "local_path": "musan",
      "transforms_allowed": true,
      "validation_roles": ["noise", "music", "speech", "vad-negative", "noise-suppression"],
      "recommended_materialization": ["noise", "music"],
      "notes": "Use noise/music as negative and robustness stress sources."
    },
    {
      "id": "openslr-slr31",
      "source": "https://www.openslr.org/31/",
      "license": "CC-BY-4.0",
      "usage_class": "commercial-validation",
