      "local_path": "LibriSpeechMini",
      "transforms_allowed": true,
      "validation_roles": ["clean-speech", "regression-clean-reference"],
      "recommended_materialization": ["dev-clean-2"],
      "notes": "Small CC-BY clean speech source for deterministic measured-RIR combinations."
    },
    {
      "id": "ami",
      "source": "https://groups.inf.ed.ac.uk/ami/download/",
      "license": "CC-BY-4.0",
      "usage_class": "commercial-validation",
      "attribution": "AMI Meeting Corpus.",
      "local_path": "AMI",
      "transforms_allowed": true,
      "validation_roles": ["meeting", "farfield", "overlap", "multispeaker", "microphone-array"],
      "recommended_materialization": ["microphone-array-audio", "manual-annotations"],
      "notes": "Signals/transcriptions and released annotations are CC BY 4.0."
    },
    {
      "id": "icsi",
      "source": "https://groups.inf.ed.ac.uk/ami/icsi/download/",
      "license": "CC-BY-4.0",
      "usage_class": "commercial-validation",
      "attribution": "ICSI Meeting Corpus.",
      "local_path": "ICSI",
      "transforms_allowed": true,
      "validation_roles": ["meeting", "overlap", "multispeaker", "spontaneous-speech"],
      "recommended_materialization": ["audio", "core-annotations"],
