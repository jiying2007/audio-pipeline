{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiying2007/audio-pipeline/source-candidate-contract-v2.schema.json",
  "title": "Audio Pipeline Source Candidate Contract v2",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "authority",
    "candidate_budget",
    "confirmation_limit",
    "source_base_sha",
    "fresh_candidate_evaluation",
    "baseline_authority_qualification_v2"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": "SOURCE_CANDIDATE_EVALUATION_ONLY"
    },
    "candidate_budget": {
      "const": 1
    },
    "confirmation_limit": {
      "type": "integer",
      "minimum": 0
    },
    "source_base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fresh_candidate_evaluation": {
      "type": "object",
      "required": [
        "candidate_value_search"
      ],
      "properties": {
        "candidate_value_search": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "baseline_authority_qualification_v2": {
      "type": "object",
      "required": [
        "policy_id",
        "qualification_profile",
        "baseline_executable_target",
        "baseline_args",
        "required_count",
        "pool_seeds",
        "generator",
        "selection_rule",
        "candidate_execution_before_lock",
        "qualification_limit",
        "authority_lock_path"
      ],
      "properties": {
        "policy_id": {
          "const": "source-candidate-baseline-qualified-authority-v2"
        },
        "qualification_profile": {
          "enum": [
            "vad-stage",
            "agc-dynamics"
          ]
        },
        "baseline_executable_target": {
          "type": "string",
          "minLength": 1
        },
        "baseline_args": {
          "type": "object"
        },
        "required_count": {
          "type": "integer",
          "minimum": 1
        },
        "pool_seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "generator": {
          "type": "object",
          "required": [
            "path",
            "seconds",
            "extra_args"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            },
            "extra_args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "selection_rule": {
          "const": "select the first N baseline-valid partitions in the preregistered pool order"
        },
        "candidate_execution_before_lock": {
          "const": false
        },
        "qualification_limit": {
          "const": 1
        },
        "authority_lock_path": {
          "type": "string",
          "pattern": "^\\\\.github/research/continuous-optimization/source-authority-locks/[A-Za-z0-9._-]+\\\\.json$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "qualification_profile": {
                "const": "vad-stage"
              }
            }
          },
          "then": {
            "properties": {
              "baseline_executable_target": {
                "const": "ap_process_pcm"
              },
              "baseline_args": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "qualification_profile": {
                "const": "agc-dynamics"
              }
            }
          },
          "then": {
            "properties": {
              "baseline_executable_target": {
                "const": "agc_dynamics_probe"
              },
              "baseline_args": {
                "type": "object",
                "required": [
                  "agc_target_dbfs",
                  "limiter_dbfs"
                ],
                "properties": {
                  "agc_target_dbfs": {
                    "type": "number"
                  },
                  "limiter_dbfs": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
