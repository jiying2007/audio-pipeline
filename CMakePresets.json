{
  "version": 3,
  "configurePresets": [
    {
      "name": "host-compose-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AP_ENABLE_LINUX_RUNTIME": "OFF",
        "AP_BUILD_TESTS": "ON",
        "AP_BUILD_BENCH": "OFF",
        "AP_BUILD_EXAMPLES": "OFF",
        "AP_STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "composition-full",
      "inherits": "host-compose-base",
      "binaryDir": "${sourceDir}/build/composition-full",
      "cacheVariables": {
        "AP_BUILD_PIPELINE": "ON",
        "AP_MODULES": "RESAMPLER,HPF,BF,SYNC,ACTIVITY,AEC,RES,NS,AGC,VAD"
      }
    },
    {
      "name": "composition-low",
      "inherits": "host-compose-base",
      "binaryDir": "${sourceDir}/build/composition-low",
      "cacheVariables": {
        "AP_BUILD_PIPELINE": "ON",
        "AP_MODULES": "RESAMPLER,HPF,BF,SYNC,ACTIVITY,AEC,RES,NS,AGC,VAD",
        "AP_BUILD_MAX_DELAY_MS": "180",
        "AP_BUILD_MAX_AEC_TAIL_MS": "64",
        "AP_RUNTIME_QUEUE_DEPTH": "4"
      }
    },
    {
      "name": "composition-tiny",
      "inherits": "host-compose-base",
      "binaryDir": "${sourceDir}/build/composition-tiny",
      "cacheVariables": {
        "AP_BUILD_PIPELINE": "ON",
        "AP_MODULES": "RESAMPLER,HPF,SYNC,ACTIVITY,AEC,RES,NS,AGC,VAD",
        "AP_BUILD_MAX_IO_RATE_HZ": "16000",
        "AP_BUILD_MAX_INTERNAL_RATE_HZ": "8000",
        "AP_BUILD_MAX_MIC_CHANNELS": "1",
        "AP_BUILD_MAX_DELAY_MS": "120",
        "AP_BUILD_MAX_AEC_TAIL_MS": "48",
        "AP_RUNTIME_QUEUE_DEPTH": "4"
      }
    },
    {
      "name": "composition-voice-frontend",
      "inherits": "host-compose-base",
      "binaryDir": "${sourceDir}/build/composition-voice-frontend",
      "cacheVariables": {
        "AP_BUILD_PIPELINE": "ON",
        "AP_MODULES": "RESAMPLER,HPF,BF,NS,AGC,VAD"
      }
    },
    {
      "name": "composition-raw",
      "inherits": "host-compose-base",
      "binaryDir": "${sourceDir}/build/composition-raw",
      "cacheVariables": {
        "AP_BUILD_PIPELINE": "ON",
        "AP_MODULES": "RESAMPLER"
      }
    },
    {
      "name": "composition-aec-only",
      "inherits": "host-compose-base",
      "binaryDir": "${sourceDir}/build/composition-aec-only",
      "cacheVariables": {
        "AP_BUILD_PIPELINE": "OFF",
        "AP_MODULES": "AEC"
      }
    },
    {
      "name": "composition-ns-only",
      "inherits": "host-compose-base",
      "binaryDir": "${sourceDir}/build/composition-ns-only",
      "cacheVariables": {
        "AP_BUILD_PIPELINE": "OFF",
        "AP_MODULES": "NS"
      }
    },
    {
      "name": "composition-activity-only",
      "inherits": "host-compose-base",
      "binaryDir": "${sourceDir}/build/composition-activity-only",
      "cacheVariables": {
        "AP_BUILD_PIPELINE": "OFF",
        "AP_MODULES": "ACTIVITY"
      }
    },
    {
      "name": "composition-fast-resampler",
      "inherits": "host-compose-base",
      "binaryDir": "${sourceDir}/build/composition-fast-resampler",
      "cacheVariables": {
        "AP_BUILD_PIPELINE": "ON",
        "AP_MODULES": "RESAMPLER,HPF,BF,SYNC,ACTIVITY,AEC,RES,NS,AGC,VAD",
        "AP_RESAMPLER_MODE": "FAST"
      }
    },
    {
      "name": "armhf-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-linux-gnueabihf.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--gc-sections",
        "AP_AEC_BACKEND": "MDF",
        "AP_ENABLE_FAST_MATH": "OFF",
        "AP_ENABLE_LINUX_RUNTIME": "ON",
        "AP_BUILD_PIPELINE": "ON",
        "AP_MODULES": "RESAMPLER,HPF,BF,SYNC,ACTIVITY,AEC,RES,NS,AGC,VAD",
        "AP_BUILD_TESTS": "OFF",
        "AP_BUILD_BENCH": "OFF",
        "AP_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "armv7a-scalar",
      "inherits": "armhf-base",
      "binaryDir": "${sourceDir}/build/armv7a-scalar",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-O3 -march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard -fdata-sections -ffunction-sections",
        "AP_SIMD_BACKEND": "SCALAR"
      }
    },
    {
      "name": "cortex-a7-scalar",
      "inherits": "armhf-base",
      "binaryDir": "${sourceDir}/build/cortex-a7-scalar",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-O3 -mcpu=cortex-a7 -mfpu=vfpv4 -mfloat-abi=hard -fdata-sections -ffunction-sections",
        "AP_SIMD_BACKEND": "SCALAR"
      }
    },
    {
      "name": "cortex-a7-neon",
      "inherits": "armhf-base",
      "binaryDir": "${sourceDir}/build/cortex-a7-neon",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-O3 -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard -fdata-sections -ffunction-sections",
        "AP_SIMD_BACKEND": "NEON"
      }
    },
    {
      "name": "cortex-a32-neon",
      "inherits": "armhf-base",
      "binaryDir": "${sourceDir}/build/cortex-a32-neon",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-O3 -mcpu=cortex-a32 -mfpu=neon-fp-armv8 -mfloat-abi=hard -fdata-sections -ffunction-sections",
        "AP_SIMD_BACKEND": "NEON"
      }
    },
    {
      "name": "aarch64-neon",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/aarch64-neon",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-O3 -march=armv8-a -fdata-sections -ffunction-sections",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--gc-sections",
        "AP_AEC_BACKEND": "MDF",
        "AP_SIMD_BACKEND": "NEON",
        "AP_ENABLE_FAST_MATH": "OFF",
        "AP_ENABLE_LINUX_RUNTIME": "ON",
        "AP_BUILD_PIPELINE": "ON",
        "AP_MODULES": "RESAMPLER,HPF,BF,SYNC,ACTIVITY,AEC,RES,NS,AGC,VAD",
        "AP_BUILD_TESTS": "OFF",
        "AP_BUILD_BENCH": "OFF",
        "AP_BUILD_EXAMPLES": "OFF"
      }
    }
  ]
}
