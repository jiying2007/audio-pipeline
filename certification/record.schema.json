{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audio-pipeline v4 SKU certification record",
  "type": "object",
  "required": [
    "schema_version", "sku", "status", "build", "platform", "audio_route",
    "performance", "acoustic", "soak", "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "sku": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "board-validated", "product-certified", "failed"]},
    "policy": {"type": "string", "minLength": 1},
    "policy_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "corpus_manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "evidence_manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "collector_version": {"type": "string", "minLength": 1},
    "toolchain_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "build": {
      "type": "object",
      "required": [
        "commit", "version", "fingerprint", "compiler", "abi",
        "source_revision", "config_digest", "compiler_id", "compiler_version",
        "target_triple", "build_type", "binary_sha256"
      ],
      "properties": {
        "commit": {"type": "string", "pattern": "^[A-Fa-f0-9]{40}$"},
        "version": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "compiler": {"type": "string", "minLength": 1},
        "abi": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "pattern": "^[A-Fa-f0-9]{40}$"},
        "config_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "compiler_id": {"type": "string", "minLength": 1},
        "compiler_version": {"type": "string", "minLength": 1},
        "target_triple": {"type": "string", "minLength": 1},
        "build_type": {"type": "string", "minLength": 1},
        "binary_sha256": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        }
      },
      "additionalProperties": true
    },
    "deployment": {
      "type": "object",
      "required": [
        "source_revision", "builder_runner", "dut_runner", "binary_sha256",
        "toolchain", "result"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "source_revision": {"type": "string", "pattern": "^[A-Fa-f0-9]{40}$"},
        "builder_runner": {"type": "string", "minLength": 1},
        "dut_runner": {"type": "string", "minLength": 1},
        "binary_sha256": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        },
        "toolchain": {
          "type": "object",
          "required": [
            "compiler_path", "compiler_sha256", "compiler_version",
            "sysroot_path", "sysroot_sha256", "toolchain_root_path",
            "toolchain_root_sha256", "cflags", "cmake_args", "cmake_args_sha256"
          ],
          "properties": {
            "compiler_path": {"type": "string", "minLength": 1},
            "compiler_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
            "compiler_version": {"type": "string", "minLength": 1},
            "sysroot_path": {"type": "string", "minLength": 1},
            "sysroot_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
            "toolchain_root_path": {"type": "string", "minLength": 1},
            "toolchain_root_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
            "cflags": {"type": "string"},
            "cmake_args": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "cmake_args_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
          },
          "additionalProperties": true
        },
        "result": {"const": "PASS"}
      },
      "additionalProperties": true
    },
    "platform": {
      "type": "object",
      "required": ["soc", "kernel", "governor", "cpuset"],
      "properties": {
        "soc": {"type": "string", "minLength": 1},
        "revision": {"type": "string"},
        "kernel": {"type": "string", "minLength": 1},
        "governor": {"type": "string", "minLength": 1},
        "cpuset": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "audio_route": {
      "type": "object",
      "required": ["capture_device", "playback_device", "sample_rate_hz", "mic_channels"],
      "properties": {
        "capture_device": {"type": "string", "minLength": 1},
        "playback_device": {"type": ["string", "null"]},
        "sample_rate_hz": {"enum": [8000, 16000, 24000, 32000, 48000]},
        "mic_channels": {"enum": [1, 2]},
        "period_frames": {"type": "integer", "minimum": 1},
        "buffer_frames": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "performance": {
      "type": "object",
      "required": [
        "active_cpu_percent", "p95_us", "p99_us", "deadline_misses", "rss_kib",
        "xruns", "overruns", "input_full_events", "output_drop_events"
      ],
      "properties": {
        "active_cpu_percent": {"type": "number", "minimum": 0},
        "idle_cpu_percent": {"type": "number", "minimum": 0},
        "p50_us": {"type": "number", "minimum": 0},
        "p95_us": {"type": "number", "minimum": 0},
        "p99_us": {"type": "number", "minimum": 0},
        "deadline_misses": {"type": "integer", "minimum": 0},
        "rss_kib": {"type": "integer", "minimum": 0},
        "xruns": {"type": "integer", "minimum": 0},
        "overruns": {"type": "integer", "minimum": 0},
        "input_full_events": {"type": "integer", "minimum": 0},
        "output_drop_events": {"type": "integer", "minimum": 0},
        "runtime_state_bytes": {"type": "integer", "minimum": 0},
        "pipeline_state_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "acoustic": {
      "type": "object",
      "required": [
        "corpus_revision", "cases_total", "cases_passed", "far_end_erle_db",
        "aec_convergence_ms", "double_talk_near_si_sdr_db",
        "noise_si_sdr_improvement_db", "vad_f1", "threshold_report"
      ],
      "properties": {
        "corpus_revision": {"type": "string", "minLength": 1},
        "cases_total": {"type": "integer", "minimum": 1},
        "cases_passed": {"type": "integer", "minimum": 0},
        "far_end_erle_db": {"type": "number"},
        "aec_convergence_ms": {"type": "number", "minimum": 0},
        "double_talk_near_si_sdr_db": {"type": "number"},
        "noise_si_sdr_improvement_db": {"type": "number"},
        "vad_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "threshold_report": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "thermal_power": {
      "type": "object",
      "required": ["ambient_c", "max_soc_c", "average_power_w"],
      "properties": {
        "ambient_c": {"type": "number"},
        "max_soc_c": {"type": "number"},
        "average_power_w": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "soak": {
      "type": "object",
      "required": [
        "hours", "passed", "xruns", "deadline_misses", "overruns",
        "input_full_events", "output_drop_events", "failed_frames", "p95_us", "p99_us"
      ],
      "properties": {
        "hours": {"type": "number", "minimum": 0},
        "passed": {"type": "boolean"},
        "xruns": {"type": "integer", "minimum": 0},
        "deadline_misses": {"type": "integer", "minimum": 0},
        "overruns": {"type": "integer", "minimum": 0},
        "input_full_events": {"type": "integer", "minimum": 0},
        "output_drop_events": {"type": "integer", "minimum": 0},
        "failed_frames": {"type": "integer", "minimum": 0},
        "p95_us": {"type": "number", "minimum": 0},
        "p99_us": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "required": [
        "result_json", "benchmark_json", "evidence_manifest", "deployment_provenance",
        "binary_sha256", "sha256"
      ],
      "properties": {
        "result_json": {"type": "string", "minLength": 1},
        "benchmark_json": {"type": "string", "minLength": 1},
        "debug_bundle": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "evidence_manifest": {"type": "string", "minLength": 1},
        "deployment_provenance": {"type": "string", "minLength": 1},
        "binary_sha256": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "product-certified"}}, "required": ["status"]},
      "then": {
        "required": [
          "policy", "thermal_power", "deployment", "policy_sha256",
          "corpus_manifest_sha256", "evidence_manifest_sha256",
          "collector_version", "toolchain_digest"
        ],
        "properties": {
          "soak": {"properties": {"passed": {"const": true}}}
        }
      }
    }
  ],
  "additionalProperties": true
}
