{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiying2007/audio-pipeline/.github/research/continuous-optimization/dataset-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "shipping_baseline", "forbidden_optimizer_tiers", "terminal_candidates", "datasets", "output_authority"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"type": "string", "minLength": 1},
    "shipping_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "source_sha", "frozen"],
      "properties": {
        "tag": {"type": "string", "minLength": 1},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "frozen": {"const": true}
      }
    },
    "forbidden_optimizer_tiers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "terminal_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "source_sha", "decision"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "decision": {"type": "string", "minLength": 1}
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_kind", "stages", "lock_path", "builder_path", "identity_key", "identity_value", "selection_roles", "evaluation_roles", "frozen_holdout", "may_promote_shipping", "notes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_kind": {"enum": ["synthetic", "public", "hosted-real", "product-external"]},
          "stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["aec", "ns", "vad", "bf", "agc", "res", "sync", "pipeline"]}},
          "lock_path": {"type": ["string", "null"]},
          "builder_path": {"type": ["string", "null"]},
          "identity_key": {"type": ["string", "null"]},
          "identity_value": {"type": ["string", "null"]},
          "selection_roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["development"]}},
          "evaluation_roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["validation", "shadow"]}},
          "frozen_holdout": {"type": "boolean"},
          "may_promote_shipping": {"const": false},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "output_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_status", "next_gate", "shipping_authority", "hil_authority", "product_certification_authority", "automatic_main_mutation"],
      "properties": {
        "candidate_status": {"const": "FROZEN_RESEARCH_CANDIDATE"},
        "next_gate": {"const": "validation-grade-blind"},
        "shipping_authority": {"const": false},
        "hil_authority": {"const": false},
        "product_certification_authority": {"const": false},
        "automatic_main_mutation": {"const": false}
      }
    }
  }
}
