{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audio-pipeline validation policy",
  "type": "object",
  "required": ["schema_version", "policy_id", "allowed_tiers", "aggregate"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "allowed_tiers": {
      "type": "array",
      "items": {"enum": ["regression", "research-validation", "validation-grade", "validation-grade-blind"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "minimum_cases": {"type": "integer", "minimum": 1},
    "required_public_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_scenarios": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "minimum_cases_by_scenario": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "minimum_pass_rate_by_scenario": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "required_dimension_values": {
      "type": "object",
      "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true}
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "min_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "min_median_near_si_sdr_improvement_db": {"type": "number"},
        "min_p10_near_si_sdr_improvement_db": {"type": "number"},
        "min_p10_noise_only_attenuation_db": {"type": "number"},
        "min_median_erle_db": {"type": "number"},
        "min_median_output_render_corr_reduction": {"type": "number"},
        "min_vad_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "min_vad_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "max_vad_false_positive_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "max_output_clip_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "max_output_dc_offset_dbfs": {"type": "number"}
      }
    }
  }
}
