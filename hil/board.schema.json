{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiying2007.github.io/audio-pipeline/hil/board.schema.json",
  "title": "audio-pipeline HIL board metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "board_id", "revision", "soc", "ram_mib", "kernel_family", "audio_codec", "mic_board_revision", "speaker_revision"],
  "properties": {
    "schema_version": {"const": 1},
    "board_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "soc": {"type": "string", "minLength": 1},
    "ram_mib": {"type": "integer", "minimum": 16},
    "kernel_family": {"type": "string", "minLength": 1},
    "audio_codec": {"type": "string", "minLength": 1},
    "mic_board_revision": {"type": "string", "minLength": 1},
    "speaker_revision": {"type": "string", "minLength": 1},
    "runner_labels": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_device", "sample_rate_hz", "mic_channels", "dsp_cpu"],
      "properties": {
        "capture_device": {"type": "string", "minLength": 1},
        "playback_device": {"type": ["string", "null"]},
        "farend_file": {"type": ["string", "null"]},
        "sample_rate_hz": {"enum": [8000, 16000, 24000, 32000, 48000]},
        "mic_channels": {"enum": [1, 2]},
        "dsp_cpu": {"type": "integer", "minimum": -1}
      }
    },
    "thermal_sensor": {"type": ["string", "null"]},
    "power_sensor": {"type": ["string", "null"]},
    "preflight_max_soc_c": {"type": "number", "minimum": -40, "maximum": 120},
    "min_free_mib": {"type": "integer", "minimum": 16},
    "power_cycle_hook": {"type": ["string", "null"]},
    "cleanup_hook": {"type": ["string", "null"]}
  }
}
