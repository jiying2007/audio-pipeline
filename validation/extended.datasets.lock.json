      "transforms_allowed": true,
      "validation_roles": ["mandarin", "meeting", "8-channel", "overlap", "speaker-activity"],
      "recommended_materialization": ["test"],
      "notes": "Share-alike obligations require separate legal/release handling; research profile only."
    },
    {
      "id": "fsd50k",
      "source": "https://zenodo.org/records/4060432",
      "license": "Mixed per-clip CC0/CC-BY/CC-BY-NC/CC-Sampling+; dataset curation CC-BY",
